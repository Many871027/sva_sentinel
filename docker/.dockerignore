# Git and IDE
.git
.gitignore
.claude
.vscode
.idea

# Python caches and environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Datasets and large model weights (managed via external volume or downloaded in container)
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# Node.js and Next.js artifacts
node_modules/
.next/
frontend/node_modules/
frontend/.next/
frontend/out/

# Logs and runtime artifacts
*.log
.DS_Store
Thumbs.db
